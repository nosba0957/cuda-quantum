module {
  func.func @sx_chain() attributes {"cudaq-entrypoint"} {
    %h = arith.constant 1.5707963267948966 : f64
    %q = quake.alloca !quake.veq<1>
    %q0 = quake.extract_ref %q[0] : (!quake.veq<1>) -> !quake.ref
    quake.rx (%h) %q0 : (f64, !quake.ref) -> ()
    quake.rx (%h) %q0 : (f64, !quake.ref) -> ()
    quake.rx (%h) %q0 : (f64, !quake.ref) -> ()
    quake.rx (%h) %q0 : (f64, !quake.ref) -> ()
    %m0 = quake.mz %q0 : (!quake.ref) -> !quake.measure
    return
  }
}
